# ============================================================================
# EXAMPLE ENVIRONMENT VARIABLES
# ============================================================================
# This file documents the variable NAMES only. It contains no real values and
# it is safe to commit.
#
# Do NOT create a real .env file with secrets in this repository. Everything
# in the repo is public the moment it deploys.
#
# These are set in the Cloudflare dashboard:
#   Workers & Pages → your project → Settings → Environment variables
# Add them to BOTH "Production" and "Preview" if you want previews to work.
# Mark WHATSAPP_ACCESS_TOKEN as "Secret" (encrypted) — not "Plaintext".
# ============================================================================


# ---------------------------------------------------------------------------
# WhatsApp Cloud API — required for lead notifications
# ---------------------------------------------------------------------------
# From Meta for Developers → your app → WhatsApp → API Setup.

# The ID of the number that SENDS the notification (not your personal number).
WHATSAPP_PHONE_NUMBER_ID=

# A permanent System User access token.
# Do not use the 24-hour temporary token from the dashboard in production —
# it will expire and lead notifications will stop silently.
# Create it under: Business Settings → System Users → Generate new token,
# with the whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=

# The number that RECEIVES each lead alert — the business owner or the sales
# desk. Digits only, country code first, no + and no spaces.
# Example for India: 919876543210
WHATSAPP_RECIPIENT=

# ---------------------------------------------------------------------------
# WhatsApp template — strongly recommended
# ---------------------------------------------------------------------------
# WhatsApp only delivers free-form text inside a 24-hour window opened by the
# recipient messaging you first. Without an approved template, notifications
# work during testing and then quietly stop a day later.
#
# Create a template in Meta Business Manager → WhatsApp Manager → Templates,
# category "Utility", with SIX body parameters in this order:
#   {{1}} customer name   {{2}} phone   {{3}} route
#   {{4}} property type   {{5}} move date   {{6}} lead ID
#
# Example body:
#   New moving lead: {{1}}, {{2}}. Route {{3}}. Property {{4}}.
#   Date {{5}}. Ref {{6}}.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Graph API version. Leave unset to use the default in functions/api/lead.js.
WHATSAPP_API_VERSION=v21.0


# ---------------------------------------------------------------------------
# Optional hardening
# ---------------------------------------------------------------------------
# Exact origin allowed to post to /api/lead. Leave unset and the endpoint
# uses its own host, which is correct for a normal single-domain deployment.
# Set it only if the site is served from a different origin than the API.
ALLOWED_ORIGIN=


# ===========================================================================
# GOOGLE REVIEWS  (optional — /api/reviews)
# ===========================================================================
# Without these, the reviews section falls back to whatever review text has
# been pasted into `testimonials.verified` in js/config.js. If that is empty
# too, the section hides itself. Nothing is ever invented to fill it.
#
# A Places API key is BILLABLE. It must never appear in js/ — anything there
# is downloaded by every visitor and public within minutes. It is read only
# by functions/api/reviews.js, on the server.
#
# Setup:
#   1. Google Cloud console → create a project → enable "Places API (New)".
#   2. Create an API key. Restrict it: Application restriction "None" (the
#      call comes from Cloudflare, not a browser), API restriction → Places
#      API (New) only. An unrestricted key is a standing invitation.
#   3. Set a billing budget alert. The free tier is generous but not infinite.
#   4. Find the Place ID for the Business Profile:
#      https://developers.google.com/maps/documentation/places/web-service/place-id
#
# Two limits worth knowing before promising anything to the client:
#   - The API returns AT MOST FIVE reviews per place. Not all 46. Five.
#     More than that has to be pasted in by hand, with the owner's agreement.
#   - Google's terms restrict how long its review content may be stored.
#     /api/reviews caches for six hours; do not raise that to save quota
#     without reading the terms first.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=


# ===========================================================================
# BINDINGS — these are NOT environment variables
# ===========================================================================
# Added under Settings → Functions → KV namespace bindings / D1 bindings.
# They are listed here so the required setup is in one place.
#
#   Variable name: LEADS   → a KV namespace
#     Used for: the lead record, per-IP rate limiting, duplicate suppression.
#     Without it the endpoint still works, but rate limiting and duplicate
#     protection are both disabled. Create one; it is free and takes a minute.
#
#   Variable name: DB      → a D1 database
#     Used for: the queryable lead table. Apply migrations/0001_leads.sql first.
#     Optional — KV alone is enough to avoid losing leads.
#
# If NEITHER is bound and the WhatsApp call also fails, /api/lead deliberately
# returns an error rather than pretending the enquiry was received. See the
# "honesty gate" in functions/api/lead.js.
