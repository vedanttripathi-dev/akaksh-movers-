               width="301" height="400" loading="lazy" decoding="async">
        </figure>
        <figure class="workshot">
          <img class="workshot__img"
               src="/assets/images/gallery/strapped-soft-items-400.jpg"
               srcset="/assets/images/gallery/strapped-soft-items-400.jpg 400w, /assets/images/gallery/strapped-soft-items-1000.jpg 1000w"
               sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 92vw"
