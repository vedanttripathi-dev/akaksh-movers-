          <img class="workshot__img"
               src="/assets/images/gallery/stack-with-edge-protection-400.jpg"
               srcset="/assets/images/gallery/stack-with-edge-protection-400.jpg 400w, /assets/images/gallery/stack-with-edge-protection-1000.jpg 1000w"
               sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 92vw"
